+    }
+  }
+  static inline bool canConvert(jsi::Runtime& runtime, const jsi::Value& value) {
+    if (value.isUndefined()) {
+      return true;
+    }
+    if (JSIConverter<TInner>::canConvert(runtime, value)) {
