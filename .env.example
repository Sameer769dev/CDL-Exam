# CDL Exam App — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
# ⚠️ Anything prefixed EXPO_PUBLIC_ is bundled into the APK and is readable by anyone.
#    Never put secrets (API keys) here. The Gemini key lives in Firebase Secret Manager:
#      firebase functions:secrets:set GEMINI_API_KEY

# Public base URL of the deployed Cloud Functions AI proxy (see /functions)
EXPO_PUBLIC_AI_BASE_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net
